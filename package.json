{
  "name": "hanamesh-brand",
  "version": "0.1.0",
  "description": "HanaMesh client brand slot occupants",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./lib/client/index.d.ts",
      "node": "./lib/client/index.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client",
    "lib/client.js",
    "COMPATIBILITY.md",
    "OPEN_SOURCE.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "build": "tsc && node scripts/build-client.mjs",
    "types": "npm run check",
    "test:contract": "npm run build && node --experimental-strip-types --test test/*.test.mjs",
    "toolchain": "node scripts/toolchain.mjs",
    "preflight": "npm run toolchain && npm run types && npm run test:contract && node scripts/preflight.mjs",
    "test:mutation": "npm run build && node scripts/mutation.mjs",
    "test:package": "node test/package-api.mjs",
    "test:profile": "node test/default-profile.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanamesh-brand.git"
  },
  "license": "MIT"
}
