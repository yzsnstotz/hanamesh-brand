{
  "name": "hanamesh-brand",
  "version": "0.1.2",
  "description": "HanaMesh client brand slot occupants",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "node": "./lib/client/index.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./assets/favicon.svg": "./assets/favicon.svg",
    "./assets/welcome-brand.svg": "./assets/welcome-brand.svg",
    "./assets/manifest.json": "./assets/manifest.json",
    "./assets/source-license.txt": "./assets/source-license.txt",
    "./ASSETS.md": "./ASSETS.md"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "lib/client",
    "lib/client.js",
    "COMPATIBILITY.md",
    "OPEN_SOURCE.md",
    "assets",
    "ASSETS.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "build": "tsc && node scripts/build-client.mjs",
    "types": "npm run check",
    "test:contract": "npm run build && node --experimental-strip-types --test test/*.test.mjs",
    "toolchain": "node scripts/toolchain.mjs",
    "preflight": "npm run toolchain && npm run types && npm run test:contract && node scripts/preflight.mjs && npm run release:check",
    "test:mutation": "npm run build && node scripts/mutation.mjs",
    "test:package": "node test/package-api.mjs",
    "test:profile": "node test/default-profile.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test:upstream": "node test/upstream-api.mjs",
    "release:check": "hanamesh-release check --lockfile package-lock.json",
    "release:publish": "hanamesh-release publish --lockfile package-lock.json",
    "prepublishOnly": "hanamesh-release source-guard"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "external": [
        "react"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1 || 4.0.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.0",
    "typescript": "5.9.3",
    "@hanamesh/release-platform-gate": "file:vendor/hanamesh-release-platform-gate-0.1.0.tgz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanamesh-brand.git"
  },
  "license": "MIT"
}
